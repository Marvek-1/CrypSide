DATABASE_URL="postgresql://<db_user>:<db_password>@localhost:5432/<db_name>"

# Telegram settings
TELEGRAM_BOT_TOKEN="<replace_with_telegram_bot_token>"
TELEGRAM_CHAT_ID="<replace_with_telegram_chat_id>"

# App logic config
LOGIC_VERSION="v1.5-quant-alpha"
CONFIG_VERSION="v1.5-quant-alpha"
PM2_SCANNER_NAME="idim-scanner"

# Python backend proxy + websocket
PYTHON_API_BASE_URL="http://127.0.0.1:8787"
NEXT_PUBLIC_API_WS_URL="<replace_with_public_ws_url>"

# Scanner config
SCAN_INTERVAL_SECONDS="300"
LOOKBACK_15M="500"
LOOKBACK_4H="300"

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="<replace_with_gemini_api_key>"

# APP_URL: The URL where this applet is hosted.
APP_URL="<replace_with_app_url>"

# Market APIs
ALPHAVANTAGE_API_KEY="<replace_with_alphavantage_api_key>"
COINMARKET_API_KEY="<replace_with_coinmarket_api_key>"
KAGGLE_API_TOKEN="<replace_with_kaggle_api_token>"

# === EXCHANGE API KEYS ===
BINANCE_BASE_URL="https://api.binance.com"
BINANCE_ID="<replace_with_binance_uid>"
BINANCE_API_KEY="<replace_with_binance_api_key>"
BINANCE_API_SECRET="<replace_with_binance_api_secret>"

# Add Bybit/OKX/Bitget keys here when available:
# BYBIT_API_KEY=
# BYBIT_API_SECRET=
# OKX_API_KEY=
# OKX_API_SECRET=
# OKX_API_PASSWORD=
# BITGET_API_KEY=
# BITGET_API_SECRET=
# BITGET_API_PASSWORD=

