# CrypSide .gitattributes
# Normalize line endings: repo stores LF, Windows checkouts get CRLF
* text=auto eol=lf

# Force LF for scripts that run on Linux/WSL
*.py    text eol=lf
*.sh    text eol=lf
*.sql   text eol=lf
*.js    text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.cjs   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.cfg   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.toml  text eol=lf
*.ini   text eol=lf

# Binary files — never touch line endings
*.pyc   binary
*.ipynb binary
*.png   binary
*.jpg   binary
*.gif   binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
*.otf   binary
*.zip   binary
*.tar   binary
*.gz    binary
